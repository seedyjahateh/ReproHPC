manifest {
    name = 'ReproHPC'
    version = '0.1.0'
    nextflowVersion = '!25.10.4'
}
params {
    outdir = 'results/run'
    sif_path = null
    sif_sha256 = null
    reference_sha256 = null
    invocation_run_id = ''
    dataset = null
    input_manifest = null
    reference = null
    science = [:]
    batch_size = 16
    partition = 'demo'
    account = ''
    qos = ''
    array_size = 4
    max_inflight = 8
    analysis_memory = '2 GB'
    analysis_time = '10 min'
}
process {
    executor = 'local'
    container = params.sif_path
    cache = 'deep'
    errorStrategy = 'terminate'
}
apptainer {
    enabled = true
    autoMounts = true
    runOptions = '--cleanenv --env SLURM_ARRAY_JOB_ID=${SLURM_ARRAY_JOB_ID:-},SLURM_ARRAY_TASK_ID=${SLURM_ARRAY_TASK_ID:-},SLURM_JOB_ID=${SLURM_JOB_ID:-}'
}
env {
    REPROHPC_RUN_ID = params.invocation_run_id
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    NUMEXPR_NUM_THREADS = '1'
    PYTHONHASHSEED = '0'
    LC_ALL = 'C'
    TZ = 'UTC'
}
executor {
    queueSize = params.max_inflight
    submitRateLimit = '1 sec'
}
profiles {
    local { includeConfig 'conf/local.config' }
    slurm { includeConfig 'conf/slurm.config' }
    slurm_scalar { includeConfig 'conf/slurm_scalar.config' }
    test { includeConfig 'conf/test.config' }
}
trace {
    enabled = true
    file = "${params.outdir}/provenance/trace.tsv"
    overwrite = false
    raw = true
    fields = 'task_id,hash,native_id,name,process,tag,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,cpus,memory,time,attempt,workdir'
}
report { enabled = true; file = "${params.outdir}/provenance/report.html" }
timeline { enabled = true; file = "${params.outdir}/provenance/timeline.html" }
dag { enabled = true; file = "${params.outdir}/provenance/dag.html" }

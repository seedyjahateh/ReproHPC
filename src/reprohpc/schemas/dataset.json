{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seedyjahateh/ReproHPC/blob/main/schemas/dataset.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "creators": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "modality": {
      "type": "string",
      "minLength": 1
    },
    "species": {
      "type": "string",
      "minLength": 1
    },
    "access": {
      "const": "public"
    },
    "doi": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^10\\.[0-9]{4,9}/[^ ]+$"
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "version",
    "title",
    "description",
    "creators",
    "license",
    "source",
    "created",
    "manifest_sha256",
    "modality",
    "species",
    "access",
    "doi"
  ],
  "additionalProperties": false
}

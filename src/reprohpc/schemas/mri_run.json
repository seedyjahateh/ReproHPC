{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seedyjahateh/ReproHPC/blob/main/schemas/mri_run.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "nextflow_session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "resumed_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "started": {
      "type": "string",
      "minLength": 1
    },
    "finished": {
      "type": "string",
      "minLength": 1
    },
    "analysis_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "params": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "algorithm": {
          "const": "fsl-bet-volumetry-v1"
        },
        "bet_frac": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "dataset": {
          "type": "string",
          "minLength": 1
        },
        "input_manifest": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "algorithm",
        "bet_frac",
        "batch_size"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object"
    },
    "software": {
      "type": "object"
    },
    "platform": {
      "type": "object"
    },
    "dataset": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "dataset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "creators": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "created": {
          "type": "string",
          "format": "date"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "modality": {
          "type": "string",
          "minLength": 1
        },
        "species": {
          "type": "string",
          "minLength": 1
        },
        "access": {
          "const": "public"
        },
        "doi": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^10\\.[0-9]{4,9}/[^ ]+$"
        }
      },
      "required": [
        "schema_version",
        "dataset_id",
        "version",
        "title",
        "description",
        "creators",
        "license",
        "source",
        "created",
        "manifest_sha256",
        "modality",
        "species",
        "access",
        "doi"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "reference_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "calibration": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "reference_id",
        "version",
        "source",
        "license",
        "calibration"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "running",
            "success",
            "failed",
            "cancelled",
            "finalization-failed"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "status",
        "exit_code",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "nextflow_session_id",
    "resumed_from",
    "started",
    "finished",
    "analysis_fingerprint",
    "command",
    "params",
    "execution",
    "software",
    "platform",
    "dataset",
    "reference",
    "status"
  ],
  "additionalProperties": false
}

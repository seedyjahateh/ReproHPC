{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seedyjahateh/ReproHPC/blob/main/schemas/analysis.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "algorithm": {
      "const": "demo-cv-v1"
    },
    "source_tree_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sif_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "science": {
      "type": "object"
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "1.0.0"
          },
          "sample_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "dtype": {
            "const": "uint8"
          },
          "channels": {
            "const": 1
          }
        },
        "required": [
          "schema_version",
          "sample_id",
          "path",
          "sha256",
          "size_bytes",
          "width",
          "height",
          "dtype",
          "channels"
        ],
        "additionalProperties": false
      }
    },
    "reference": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "reference_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "calibration": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "reference_id",
        "version",
        "source",
        "license",
        "calibration"
      ],
      "additionalProperties": false
    },
    "calibration": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "pixel_size_um": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "unit": {
          "const": "um"
        }
      },
      "required": [
        "schema_version",
        "pixel_size_um",
        "unit"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "algorithm",
    "source_tree_sha256",
    "sif_sha256",
    "science",
    "samples",
    "reference",
    "calibration"
  ],
  "additionalProperties": false
}

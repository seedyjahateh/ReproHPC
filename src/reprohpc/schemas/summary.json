{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seedyjahateh/ReproHPC/blob/main/schemas/summary.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "expected_samples": {
      "type": "integer",
      "minimum": 0
    },
    "processed_samples": {
      "type": "integer",
      "minimum": 0
    },
    "object_count": {
      "type": "integer",
      "minimum": 0
    },
    "qc": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "NO_OBJECTS",
          "BORDER_OBJECTS"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "required": [
    "schema_version",
    "expected_samples",
    "processed_samples",
    "object_count",
    "qc"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seedyjahateh/ReproHPC/blob/main/schemas/status.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "running",
        "success",
        "failed",
        "cancelled",
        "finalization-failed"
      ]
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "status",
    "exit_code",
    "message"
  ],
  "additionalProperties": false
}

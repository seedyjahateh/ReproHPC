{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seedyjahateh/ReproHPC/blob/main/schemas/output.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object"
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "type": "string",
      "minLength": 1
    },
    "producing_task": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "path",
    "sha256",
    "size_bytes",
    "media_type",
    "scope",
    "role",
    "schema",
    "producing_task"
  ],
  "additionalProperties": false
}

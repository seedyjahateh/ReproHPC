{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seedyjahateh/ReproHPC/blob/main/schemas/calibration.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "pixel_size_um": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "unit": {
      "const": "um"
    }
  },
  "required": [
    "schema_version",
    "pixel_size_um",
    "unit"
  ],
  "additionalProperties": false
}

* text=auto
*.py text eol=lf
*.nf text eol=lf
*.config text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
reprohpc text eol=lf
*.png binary
*.npy binary

# Byte-exact manifests and locks: their SHA-256 values are recorded, so line endings must not change.
*.csv text eol=lf
*.tsv text eol=lf
*.sha256 text eol=lf
*.lock text eol=lf
*.in text eol=lf
Dockerfile* text eol=lf
